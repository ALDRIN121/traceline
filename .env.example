# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Used ONLY by live/LLM integration tests and live demo runs (harness authoring,
# sample-agent live mode, LLM judge). The entire offline test suite runs without it.

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Engine
# Defaults to ./eval.db. Set a deployment-specific DATABASE_URL outside the
# repository when using PostgreSQL; no shared database credential is supplied.
LLM_AGENT_EVAL_DB=./eval.db

# Optional Compose PostgreSQL overrides. If omitted, the first Compose start
# generates distinct URL-safe secrets in the persistent eval_credentials volume.
# The maintenance login runs migrations once; the engine uses the non-bypass app login.
POSTGRES_MAINT_PASSWORD=replace-with-a-long-unique-maintenance-password
POSTGRES_APP_PASSWORD=replace-with-a-long-unique-app-password
